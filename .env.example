# Copie para .env e ajuste. O .env é lido automaticamente por `npm start` / `npm run dev`.

# Senha do painel administrativo. OBRIGATÓRIA em produção (mínimo 12 caracteres).
# Em desenvolvimento, se ficar vazia, uma senha temporária é gerada e exibida no terminal.
ADMIN_PASSWORD=

# "production" ativa cookies Secure (exige HTTPS) e torna ADMIN_PASSWORD obrigatória.
NODE_ENV=development

PORT=3000
HOST=0.0.0.0

# Arquivo do banco SQLite. Em produção, aponte para um disco PERSISTENTE.
DATABASE_FILE=./data/urna.db

# URL pública usada nos links compartilhados (ex.: https://urna.suaempresa.com.br).
# Se vazia, usa o endereço pelo qual o administrador acessou o painel.
PUBLIC_BASE_URL=

# Defina como 1 quando estiver atrás de proxy reverso/HTTPS (Render, Railway, Nginx).
TRUST_PROXY=0

# Duração da sessão do administrador, em horas.
SESSION_TTL_HOURS=12

# Envios de cédula por IP por minuto (proteção contra scripts). Pessoas na mesma
# rede Wi-Fi compartilham o IP: aumente para eventos grandes num mesmo local.
VOTE_RATE_LIMIT=120

# Tentativas de login por IP a cada 15 minutos.
LOGIN_RATE_LIMIT=10

# 1 = garante a urna pronta: ao iniciar, cria em rascunho a votação com a lista de
# server/db/seed.js e a recria se tiver sido excluída. Use 0 para não criar automaticamente
# (o botão "Criar urna pronta" do painel continua disponível).
SEED_LEGACY_POLL=1

# Imagens das alternativas: 0 = desativadas (padrão), 1 = ativadas.
# As imagens já salvas ficam guardadas e voltam a aparecer ao ativar.
OPTION_IMAGES=0

# Fuso usado nas datas dos arquivos gerados.
TZ_DISPLAY=America/Sao_Paulo
