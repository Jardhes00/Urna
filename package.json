{
  "name": "urna-online",
  "version": "2.0.0",
  "description": "Urna eletrônica online com voto anônimo, painel administrativo e geração de PowerPoint/Excel.",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "test": "node --test --test-force-exit --test-timeout=60000 --test-concurrency=1 \"test/unit/*.test.js\" \"test/api/*.test.js\"",
    "test:e2e": "node --test --test-force-exit --test-timeout=60000 --test-concurrency=1 \"test/e2e/*.test.js\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.1",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  }
}
